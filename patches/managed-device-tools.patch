+
+it.effect("managed mode rejects a missing or incomplete tool without removing files or invoking npm", () =>
+  Effect.gen(function* () {
+    const original = process.env.T3CODE_DEVICE_TOOLS_MANAGED;
+    process.env.T3CODE_DEVICE_TOOLS_MANAGED = "1";
+    yield* Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const baseDir = yield* fs.makeTempDirectoryScoped({ prefix: "t3-managed-" });
+      const install = path.join(baseDir, "tools", "expo-device-hub", DEVICE_HUB_VERSION);
+      yield* fs.makeDirectory(install, { recursive: true });
+      yield* fs.writeFileString(path.join(install, "keep"), "untouched");
+      let invoked = false;
+      const runner = { run: () => { invoked = true; return Effect.die("unexpected install"); } };
+      const error = yield* ensureDeviceHub(baseDir).pipe(
+        Effect.provideService(ProcessRunner.ProcessRunner, runner), Effect.flip,
+      );
+      expect(error.message).toContain("automatic installation is disabled");
+      expect(invoked).toBe(false);
+      expect(yield* fs.readFileString(path.join(install, "keep"))).toBe("untouched");
+      const entry = path.join(install, "node_modules/expo-device-hub/dist/server/cli.mjs");
+      yield* fs.makeDirectory(path.dirname(entry), { recursive: true });
+      yield* fs.writeFileString(entry, "");
+      yield* fs.writeFileString(path.join(install, ".install-complete"), DEVICE_HUB_VERSION);
+      yield* fs.writeFileString(path.join(install, "node_modules/expo-device-hub/package.json"), JSON.stringify({ version: "0.0.0" }));
+      const wrongVersion = yield* ensureDeviceHub(baseDir).pipe(Effect.provideService(ProcessRunner.ProcessRunner, runner), Effect.flip);
+      expect(wrongVersion.message).toContain("automatic installation is disabled");
+      yield* fs.writeFileString(path.join(install, "node_modules/expo-device-hub/package.json"), JSON.stringify({ version: DEVICE_HUB_VERSION }));
+      const ready = yield* ensureDeviceHub(baseDir).pipe(Effect.provideService(ProcessRunner.ProcessRunner, runner));
+      expect(ready.entryPath).toBe(entry);
+      expect(invoked).toBe(false);
+    }).pipe(Effect.ensuring(Effect.sync(() => {
+      if (original === undefined) delete process.env.T3CODE_DEVICE_TOOLS_MANAGED;
+      else process.env.T3CODE_DEVICE_TOOLS_MANAGED = original;
+    })));
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
